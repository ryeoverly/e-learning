<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>E-Learning | Science Homepage</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      background: #f5f9ff;
      color: #222;
    }

    header {
      background: #004aad;
      color: white;
      padding: 20px;
      text-align: center;
    }

    nav {
      display: flex;
      justify-content: center;
      background: #003580;
      padding: 10px;
    }

    nav a {
      color: white;
      margin: 0 15px;
      text-decoration: none;
      font-weight: bold;
    }

    .container {
      padding: 20px;
    }

    h2 {
      text-align: center;
      margin-bottom: 20px;
    }

    .courses {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 20px;
    }

    .card {
      background: white;
      padding: 15px;
      border-radius: 10px;
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
      transition: transform 0.2s;
    }

    .card:hover {
      transform: scale(1.05);
    }

    .card h3 {
      margin-top: 0;
    }

    .btn {
      display: inline-block;
      margin-top: 10px;
      padding: 8px 15px;
      background: #004aad;
      color: white;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      text-decoration: none;
    }

    .btn:hover {
      background: #0066ff;
    }
  </style>
</head>
<body>
  <header>
    <h1>Science Learning Hub</h1>
    <p>Explore Physics, Chemistry, Biology & more</p>
  </header>

  <nav>
    <a href="#">Home</a>
    <a href="#">My Courses</a>
    <a href="#">Quizzes</a>
    <a href="#">Profile</a>
  </nav>

  <div class="container">
    <h2>Featured Science Courses</h2>
    <div class="courses" id="courseList"></div>
  </div>

  <script>
    // Sample Science Courses Data
    const courses = [
      { title: "Physics Fundamentals", description: "Learn motion, forces, energy, and more." },
      { title: "Chemistry Basics", description: "Explore atoms, molecules, and reactions." },
      { title: "Biology Essentials", description: "Understand cells, genetics, and ecosystems." },
      { title: "Astronomy 101", description: "Discover the universe, planets, and stars." },
      { title: "Earth Science", description: "Study geology, weather, and natural systems." }
    ];

    // Render Courses Dynamically
    const courseList = document.getElementById("courseList");

    courses.forEach(course => {
      const card = document.createElement("div");
      card.className = "card";

      card.innerHTML = `
        <h3>${course.title}</h3>
        <p>${course.description}</p>
        <a href="#" class="btn">Start Learning</a>
      `;

      courseList.appendChild(card);
    });
  </script>
</body>
</html>
